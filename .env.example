# Railway entrega esta variable automáticamente al conectar PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flor_semanal
PORT=3000
NODE_ENV=development

# Usa tres contraseñas diferentes y una clave aleatoria de al menos 32 caracteres.
AUTH_PRODUCTION_PASSWORD=2026
AUTH_POSCOSECHA_PASSWORD=2025
AUTH_VIEWER_PASSWORD=cambia-esta-contrasena-de-consulta
SESSION_SECRET=coloca-una-clave-aleatoria-larga-y-unica

