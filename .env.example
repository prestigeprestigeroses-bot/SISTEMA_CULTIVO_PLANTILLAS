# Railway entrega esta variable automáticamente al conectar PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flor_semanal
PORT=3000
NODE_ENV=development

# Ejemplos de 5 caracteres: reemplázalos por tres contraseñas distintas de tu elección.
AUTH_PRODUCTION_PASSWORD=PROD1
AUTH_POSCOSECHA_PASSWORD=POSC2
AUTH_VIEWER_PASSWORD=LEER3
# Esta clave interna sigue necesitando al menos 32 caracteres aleatorios.
SESSION_SECRET=coloca-una-clave-aleatoria-larga-y-unica

